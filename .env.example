# Copy to .env and fill in. The reports pipeline reads these from the environment.
# (.env is gitignored. Load it however you prefer — e.g. `set -a; . ./.env; set +a`.)

# --- the LLM (Phase 4 synthesis) ---
# Pick ONE of the two auth styles below.

# Option A: the provider AI (a cloud GCP project). Needs Application Default
# Credentials (`gcloud auth application-default login`) OR a the provider express-mode
# API key in GOOGLE_API_KEY.
LLM_USE_CLOUD=true
LLM_PROJECT=your-gcp-project-id
LLM_REGION=global
# GOOGLE_API_KEY=...           # only if using a the provider express-mode API key

# Option B: the LLM Developer API (key from your provider console). Leave
# LLM_USE_CLOUD unset/false and set just the key:
# GOOGLE_API_KEY=...

# Model (optional; default the-model)
LLM_MODEL=the-model

# --- Email delivery (Phase 4 reports) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# Gmail: create an App Password (Account -> Security -> App passwords), not your login password.
SMTP_PASS=your-app-password
REPORT_FROM=you@gmail.com
REPORT_TO=you@gmail.com
