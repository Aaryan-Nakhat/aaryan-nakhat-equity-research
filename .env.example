# Copy to .env and fill in. The reports pipeline reads these from the environment.
# (.env is gitignored. Load it however you prefer — e.g. `set -a; . ./.env; set +a`.)

# --- LLM (bring your own — fully provider-agnostic, via LiteLLM) ---
# The synthesis layer talks only to common/llm.py; the model + provider come entirely from here.
LLM_MODEL=                     # LiteLLM model string, e.g. gpt-4o  |  claude-3-5-sonnet-latest  |  <vendor>/<model>
LLM_API_KEY=                   # your provider API key (omit if the backend uses ambient credentials)
# LLM_BASE_URL=                # optional: a custom API base URL (self-hosted, gateway, router…)
# LLM_SEARCH_TOOL=             # optional JSON: the web-search tool spec your model accepts, to enable the
#                              # grounded discovery features (screeners). Leave unset to run un-grounded.
#
# The model string selects the provider (see LiteLLM's provider list). Some backends read their own
# extra env vars (e.g. a project/region/credentials file for a cloud provider, or an org id) — add
# whatever your chosen model needs here; it all stays in this gitignored file.
#
# Capabilities that degrade gracefully: PDF filing-reading (deep report) and web-grounded discovery
# (screeners) run only where the model supports them; elsewhere the call is text-only / un-grounded.

# --- Email bot (interactive reports + watchlist digest) ---
# The bot's account is ONE Gmail used to both send reports and read requests.
# Gmail: enable 2-Step Verification, then create an App Password (Account ->
# Security -> App passwords) and use it for SMTP_PASS and IMAP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASS=your-16-char-app-password
REPORT_FROM=you@gmail.com
# Daily digest is sent here; and ONLY these senders may request reports
# (comma-separated). You email the bot FROM one of these (e.g. a 2nd address).
REPORT_TO=you@gmail.com
EMAIL_ALLOWED_SENDERS=you@work.com

# --- Watchlist seed (scripts/populate_watchlist.py) ---
# Your personal portfolio is NOT hardcoded in the repo — it's seeded from here.
# Comma-separated company names OR NSE symbols. Leave blank to skip.
WATCHLIST_HOLDINGS=reliance industries, hdfc bank, tata consultancy services
WATCHLIST_TRACKING=infosys, larsen and toubro

# --- NSE browser-tier opt-in ---
# The NSE /api tier loads a real page to clear NSE's bot challenge. NSE's Terms
# of Use restrict automated access and redistribution of its data, so this tier
# is OFF by default. Set to true ONLY if you have reviewed NSE's terms and accept
# responsibility for complying (no redistribution of NSE data). See SOURCES.md.
NSE_SCRAPING_ENABLED=false

# Employer-reviews (AmbitionBox) browser tier for the deep report's "🏢 inside view"
# (employee & management sentiment). OFF by default — automated access is subject to
# AmbitionBox's Terms of Service; set true only for personal research. See SOURCES.md.
EMPLOYER_REVIEWS_ENABLED=false
# Optional slug overrides for companies whose name the resolver mis-maps to a namesake
# (comma-separated SYMBOL=ambitionbox-slug pairs). Kept here (not in code) so no specific
# tickers live in the repo. Example:
# EMPLOYER_SLUG_OVERRIDES=EXAMPLECO=example-co, OTHERCO=other-co-ltd

# --- Compliance ---
# Footer stamped on every emailed report + PDF. A built-in default is used when
# unset; customise it here, or set it EMPTY to disable (not recommended for a
# public-facing tool — it states the output is research, not investment advice).
# REPORT_DISCLAIMER=
